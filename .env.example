DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/content_os
NVIDIA_API_KEY=your_nvidia_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
OPENAI_SPEECH_VOICE=alloy
REPLICATE_API_TOKEN=your_replicate_api_token_here
# Optional V2.8 providers. Server-side only; never expose these values to the Dashboard client.
FAL_KEY=your_fal_api_key_here
RUNWAYML_API_SECRET=your_runway_api_secret_here
GOOGLE_API_KEY=your_google_ai_api_key_here
LUMA_API_KEY=your_luma_api_key_here
# Dashboard QUALITY defaults. The resolved route is persisted at preflight/create time.
DEFAULT_QUALITY_PROVIDER=replicate
DEFAULT_QUALITY_MODEL=wan-video/wan-2.2-t2v-fast
DEFAULT_QUALITY_PROFILE=STANDARD
# Keep experimental catalog models unavailable unless an operator explicitly opts in.
V28_ALLOW_EXPERIMENTAL_MODELS=false
VIDEO_PROVIDER=replicate
# V2.7.1 QUALITY is explicit and fail-closed. Set a model supported by the installed adapter.
QUALITY_VIDEO_PROFILE=production
QUALITY_VIDEO_PROVIDER=replicate
QUALITY_VIDEO_MODEL=owner/model
QUALITY_VIDEO_RESOLUTION=720p
QUALITY_VIDEO_GO_FAST=false
QUALITY_VIDEO_OPTIMIZE_PROMPT=true
QUALITY_VIDEO_INTERPOLATE_OUTPUT=true
QUALITY_VIDEO_NUM_FRAMES=121
QUALITY_VIDEO_FPS=24
QUALITY_VIDEO_SAMPLE_SHIFT=12
QUALITY_VIDEO_SEED_STRATEGY=per-shot-deterministic
REAL_PRODUCTION_INPUT=config/productions/attune-dont-guess-tune-in.json
LIVE_PAID_GENERATION=false
RENDER_MODE=QUALITY
AUDIO_PROVIDER=openai-media
CONTENT_FACTORY_STORAGE_ROOT=/absolute/path/to/content-factory-artifacts
# Optional V2.6 FAST renderer. Keep the pinned v1.3.3 service on localhost/private networking.
FAST_RENDERER=moneyprinterturbo
MPT_ENABLED=false
MPT_BASE_URL=http://127.0.0.1:8080
MPT_VERSION=v1.3.3
MPT_REQUEST_TIMEOUT_MS=15000
MPT_POLL_INTERVAL_MS=2000
MPT_MAX_WAIT_MS=900000
MPT_MAX_OUTPUT_BYTES=268435456
MPT_HEALTHCHECK=true
# Required fail-closed operator attestation; companion startup also verifies both upstream flags.
MPT_AUTO_PUBLISH_DISABLED=true
# Companion Compose only; point to an uncommitted MoneyPrinterTurbo config.toml.
MPT_CONFIG_FILE=/absolute/path/to/moneyprinterturbo/config.toml
MPT_HOST_PORT=8080
DASHBOARD_ACTOR=local-operator
DASHBOARD_API_HOST=127.0.0.1
DASHBOARD_API_PORT=3001
DASHBOARD_WEB_HOST=127.0.0.1
DASHBOARD_WEB_PORT=3000
