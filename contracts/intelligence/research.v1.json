{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"content-factory/research.v1",
  "title":"Evidence-backed Research Artifact",
  "type":"object",
  "required":["research_id","claims","sources","confidence","cross_check"],
  "properties":{
    "research_id":{"type":"string","minLength":1},
    "claims":{"type":"array","items":{"type":"object","required":["claim","classification","confidence","source_ids"],"properties":{"claim":{"type":"string"},"classification":{"enum":["FACT","INFERENCE","ASSUMPTION"]},"confidence":{"enum":["HIGH","MEDIUM","LOW","UNVERIFIED"]},"source_ids":{"type":"array","minItems":1,"items":{"type":"string"}}}}},
    "sources":{"type":"array","items":{"type":"object","required":["source_id","url","title","retrieved_at"],"properties":{"source_id":{"type":"string"},"url":{"type":"string","format":"uri"},"title":{"type":"string"},"published_at":{"type":["string","null"]},"retrieved_at":{"type":"string","format":"date-time"}}}},
    "confidence":{"enum":["HIGH","MEDIUM","LOW","UNVERIFIED"]},
    "cross_check":{"type":"object","required":["independent_source_count","contradictions_found"],"properties":{"independent_source_count":{"type":"integer","minimum":0},"contradictions_found":{"type":"boolean"}}}
  }
}
