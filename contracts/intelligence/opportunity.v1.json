{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content-factory/opportunity.v1",
  "title": "Content Factory Opportunity Contract",
  "type": "object",
  "required": ["opportunity_id", "status", "signals", "sources", "scores", "decision_policy"],
  "properties": {
    "opportunity_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["PROPOSED", "APPROVED", "REJECTED", "EDIT_REQUIRED", "EXPIRED"]},
    "thesis": {"type": "string"},
    "angle": {"type": "string"},
    "signals": {"type": "array", "items": {"type": "object", "required": ["type", "claim", "confidence"]}},
    "sources": {"type": "array", "items": {"type": "object", "required": ["url", "title", "retrieved_at"]}},
    "scores": {"type": "object", "required": ["demand", "momentum", "competition", "content_gap", "production_cost", "monetization", "platform_fit", "overall"]},
    "decision_policy": {
      "type": "object",
      "required": ["human_approval_required", "auto_production_allowed"],
      "properties": {
        "human_approval_required": {"const": true},
        "auto_production_allowed": {"const": false}
      }
    },
    "approved_by": {"type": "string"},
    "approved_at": {"type": "string", "format": "date-time"},
    "decision_note": {"type": "string"}
  }
}
